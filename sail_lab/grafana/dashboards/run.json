{
  "uid": "sail-lab-run",
  "title": "Sail Lab - Run",
  "description": "One run end to end: its Sail operators, queries, traces, resources and logs",
  "tags": [
    "sail",
    "lakesail",
    "spark-connect"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "lab_run_info",
          "refId": "run",
          "qryType": 3
        },
        "definition": "lab_run_info",
        "regex": "/run_id=\"(?<value>(?<text>[0-9a-f]{8})[^\"]*)\"/",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "description": "Recent runs. Open from ./lab or the overview table to pick any run"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/sail-lab-overview/sail-lab-overview",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Run",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Run",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lab-api"
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lab-api"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://lab-api:8010/runs/$run",
          "parser": "backend",
          "root_selector": "",
          "url_options": {
            "method": "GET"
          },
          "columns": [
            {
              "selector": "short_id",
              "text": "run",
              "type": "string"
            },
            {
              "selector": "job",
              "text": "job",
              "type": "string"
            },
            {
              "selector": "kind",
              "text": "kind",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "status",
              "type": "string"
            },
            {
              "selector": "submitted",
              "text": "submitted",
              "type": "timestamp"
            },
            {
              "selector": "duration_seconds",
              "text": "duration",
              "type": "number"
            },
            {
              "selector": "queue_seconds",
              "text": "queued",
              "type": "number"
            },
            {
              "selector": "max_rss_bytes",
              "text": "client peak RSS",
              "type": "number"
            },
            {
              "selector": "exit_code",
              "text": "exit",
              "type": "number"
            },
            {
              "selector": "args",
              "text": "args",
              "type": "string"
            },
            {
              "selector": "conf",
              "text": "conf",
              "type": "string"
            },
            {
              "selector": "error",
              "text": "error",
              "type": "string"
            }
          ]
        }
      ],
      "description": "GET /runs/<id> on the lab API. The run id is also the Spark Connect session id.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "running": {
                        "color": "blue",
                        "index": 1
                      },
                      "queued": {
                        "color": "purple",
                        "index": 2
                      },
                      "failed": {
                        "color": "red",
                        "index": 3
                      },
                      "timed_out": {
                        "color": "orange",
                        "index": 4
                      },
                      "cancelled": {
                        "color": "yellow",
                        "index": 5
                      },
                      "lost": {
                        "color": "dark-red",
                        "index": 6
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "duration|queued"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client peak RSS"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "table",
      "title": "Values reported by the job (saillab.sdk.report / timed)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (key) (lab_run_result{run_id=\"$run\"})",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "description": "session_ready_seconds is measured by the bootstrap; *_seconds come from timed() blocks",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "key"
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "key": "key",
              "Value": "value"
            }
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "id": 3
    },
    {
      "type": "bargauge",
      "title": "Compute time by operator",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (execution_operator_name) (max_over_time(execution_elapsed_compute_time_seconds{session_id=\"$run\"}[$__range]))",
          "legendFormat": "{{execution_operator_name}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "description": "Summed over partitions and over all queries of the run",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "id": 4
    },
    {
      "type": "bargauge",
      "title": "Rows produced by operator",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (execution_operator_name) (max_over_time(execution_output_row_count{session_id=\"$run\"}[$__range]))",
          "legendFormat": "{{execution_operator_name}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Queries of this session",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Per query (Sail execution job)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (execution_job_id) (max_over_time(execution_elapsed_compute_time_seconds{session_id=\"$run\"}[$__range]))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (execution_job_id) (max_over_time(execution_spill_size_byte{session_id=\"$run\"}[$__range]))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "count by (execution_job_id) (max_over_time(execution_output_row_count{session_id=\"$run\"}[$__range]))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "description": "One row per query Sail executed for this session",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "compute time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spilled"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "execution_job_id": "query",
              "Value #A": "compute time",
              "Value #B": "spilled",
              "Value #C": "operators"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "query",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "query"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 9
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Rows produced per operator (live)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (execution_operator_name) ({session_id=\"$run\", __name__='execution_output_row_count'})",
          "legendFormat": "{{execution_operator_name}}",
          "format": "time_series"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 9
      },
      "id": 8
    },
    {
      "type": "bargauge",
      "title": "Spill by operator",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (execution_operator_name) (max_over_time(execution_spill_size_byte{session_id=\"$run\"}[$__range])) > 0",
          "legendFormat": "{{execution_operator_name}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "description": "Empty means nothing spilled",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 9
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Query traces (click a trace id to open it in Tempo)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ span.session.id = \"$run\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "description": "Sail's spans: handle_execute_plan -> JobRunner::execute -> one span per operator",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "Resources while the run was active",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "CPU (sail vs PySpark clients in lab-api)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (rate(lab_container_cpu_seconds_total{service=~\"sail|lab-api\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "format": "time_series"
        }
      ],
      "description": "Cores in use. Shared by all runs active at the same time",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Memory (working set)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (lab_container_memory_working_set_bytes{service=~\"sail|lab-api\"})",
          "legendFormat": "{{service}}",
          "format": "time_series"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "S3 traffic (MinIO)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(minio_s3_traffic_received_bytes[$__rate_interval]))",
          "legendFormat": "written",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(minio_s3_traffic_sent_bytes[$__rate_interval]))",
          "legendFormat": "read",
          "format": "time_series"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "id": 14
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "id": 15
    },
    {
      "type": "logs",
      "title": "Run log (client stdout/stderr)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"lab-run\"} | run_id=\"$run\"",
          "queryType": "range"
        }
      ],
      "description": "The same text as ./lab logs <run>, shipped to Loki by the OTel collector",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 14,
        "h": 14
      },
      "id": 16
    },
    {
      "type": "logs",
      "title": "Sail server log lines for this session",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"sail-server\"} |= \"$run\"",
          "queryType": "range"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 14,
        "y": 43,
        "w": 10,
        "h": 14
      },
      "id": 17
    }
  ]
}
